DATABASE_NAME=lookup_portal
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-me
DATABASE_HOST=localhost
DATABASE_PORT=5432
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
R2_ACCOUNT_ID=replace-me
R2_ACCESS_KEY_ID=replace-me
R2_SECRET_ACCESS_KEY=replace-me
R2_BUCKET_NAME=replace-me
R2_ENDPOINT=https://your-account.r2.cloudflarestorage.com
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Backend only. Do not expose the key through NEXT_PUBLIC_* variables.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_TIMEOUT_SECONDS=60
GEMINI_BATCH_CHARS=24000
GEMINI_MAX_BATCHES=8
